# Copy to .env and fill in. Never commit .env.

# Qloo hackathon key (request: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
QLOO_API_KEY=
# Hackathon keys only work against this base URL
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Save real API responses as JSON fixtures (used for tests and as a fallback for demo flows)
QLOO_RECORD_FIXTURES=false
# Directory of prebuilt demo presets (default backend/presets; never commit them)
PRESETS_DIR=

# Live pair check (POST /api/pair): at most 3 Qloo requests per check, off unless true. Caps are per server instance.
# PAIR_CHECK_ENABLED=false
# PAIR_CHECKS_PER_VISITOR_HOUR=8
# PAIR_CHECKS_PER_VISITOR_DAY=20
# PAIR_CHECKS_PER_DAY=60
# Requests to keep in the month: below it, or after 6 requests sent without Qloo's allowance header, the pair
# check and the agent's Qloo-backed tools stop calling Qloo
# QLOO_QUOTA_FLOOR=1500
