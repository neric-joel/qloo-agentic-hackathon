# Origin of the API service that /api/* is proxied to (no trailing slash).
# Leave empty to use http://127.0.0.1:8000 (the local backend).
BACKEND_URL=

# Set to 1 to replay a simulated event stream instead of calling the backend.
# Build-time flag: keep it unset in production deployments.
NEXT_PUBLIC_MOCK_STREAM=

# Visitor stamp: the proxy signs the caller's address for the API's per-visitor caps. Must equal the API
# project's VISITOR_STAMP_SECRET. Leave empty and nothing is signed (incoming stamp headers are still removed).
VISITOR_STAMP_SECRET=
